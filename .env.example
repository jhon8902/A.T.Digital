# Google Analytics 4 — ID de medición (Flujos de datos → tu web)
PUBLIC_GA_MEASUREMENT_ID=G-0X4XEQZVY3

# Base de datos (obligatorio para guardar notas en /formulario)
DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require

# Acceso al formulario (Basic Auth)
FORMULARIO_ADMIN_USER=tu_usuario
FORMULARIO_ADMIN_PASSWORD=tu_clave

# Cloudinary (subida de imágenes y videos en /formulario)
PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned
PUBLIC_CLOUDINARY_FOLDER=atdigital/notas
PUBLIC_CLOUDINARY_VIDEO_FOLDER=atdigital/pruebas

# URLs de API
# En desarrollo local usa npm run dev → http://localhost:4321
# Ver docs/desarrollo-local.md (timeout formulario, dev-admin-api)
API_BASE_URL=http://localhost:4321

# Estas variables se cargan automáticamente en src/lib/api.ts
# Cambialas en Netlify UI si necesitas ajustes en producción
