---
import { resolveSiteNotes, type SiteNote } from "../../lib/api";
import { normalizeNoteCategory } from "../../lib/notes-query";
import SectionMoreArrow from "../home/SectionMoreArrow.astro";
import {
  formatNotePublishedLabel,
  getNotePublishTimestamp,
} from "../../lib/note-scheduling";

type MotoItem = {
  href: string;
  img: string;
  alt: string;
  title: string;
  description: string;
  fecha?: string;
  source_scope?: string;
  sortDate: number;
};

interface Props {
  notes?: SiteNote[];
}

const { notes: prefetchedNotes } = Astro.props as Props;
const HOME_VISIBLE_COUNT = 5;

function normalizeSourceScope(scope?: string) {
  return scope?.toLowerCase() === "internacional"
    ? "internacional"
    : "nacional";
}

function sourceScopeLabel(scope?: string) {
  return normalizeSourceScope(scope) === "internacional"
    ? "Internacional"
    : "Nacional";
}

function cleanPublishedDate(value?: string) {
  const cleaned = (value || "").replace(/^Publicado:\s*/i, "").trim();
  if (!cleaned) return "";
  if (/\d{4}/.test(cleaned)) return cleaned;
  if (/^\d{1,2}-[a-záéíóúüñ]+$/i.test(cleaned)) return `${cleaned}-2025`;
  return cleaned;
}

function extractFirstImage(html: string | undefined) {
  if (!html) return null;
  const match = html.match(/<img[^>]+src=["']([^"']+)["'][^>]*>/i);
  return match ? match[1] : null;
}

let motos: MotoItem[] = [];

try {
  const data = await resolveSiteNotes(prefetchedNotes);

  motos = data
    .filter((note) => normalizeNoteCategory(note.category) === "motos")
    .map((note) => ({
      href: `/notas/${note.id}`,
      img:
        note.image1?.trim() ||
        extractFirstImage(note.content) ||
        "/img/default.jpg",
      alt: note.title || "Motos",
      title: note.title || "Sin título",
      description: (note.subtitle || "").trim(),
      fecha: formatNotePublishedLabel(note),
      source_scope: normalizeSourceScope(note.source_scope),
      sortDate: getNotePublishTimestamp(note),
    }))
    .sort((a, b) => b.sortDate - a.sortDate)
    .slice(0, HOME_VISIBLE_COUNT);
} catch (err) {
  console.error("Error cargando motos:", err);
}

const lead = motos[0];
const rest = motos.slice(1);
---

<link rel="stylesheet" href="/css/motos-section.css?v=2" />

<section id="motos" class="motos-section" aria-labelledby="motos-heading">
  <div class="motos-panel">
    <header class="motos-head">
      <h2 id="motos-heading" class="motos-title">
        <a href="/motos" class="section-heading-link">
          Motos
          <span class="section-archive-hint" aria-hidden="true">Ver el archivo</span>
        </a>
      </h2>
    </header>

    {
      !lead && (
        <p class="motos-empty">
          Lanzamientos, eventos y novedades de motocicletas.
        </p>
      )
    }

    {
      lead && (
        <article class="motos-lead">
          <a href={lead.href} class="motos-lead__media">
            <img
              src={lead.img}
              alt={lead.alt}
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="motos-lead__copy">
            <p class="motos-kicker">
              {sourceScopeLabel(lead.source_scope)}
              {cleanPublishedDate(lead.fecha)
                ? ` · ${cleanPublishedDate(lead.fecha)}`
                : ""}
            </p>
            <h3>
              <a href={lead.href}>{lead.title}</a>
            </h3>
            {lead.description && <p class="motos-deck">{lead.description}</p>}
          </div>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ul class="motos-list">
          {rest.map((nota) => (
            <li>
              <a href={nota.href}>
                <img
                  src={nota.img}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span class="motos-list__copy">
                  <span class="motos-kicker">
                    {sourceScopeLabel(nota.source_scope)}
                    {cleanPublishedDate(nota.fecha)
                      ? ` · ${cleanPublishedDate(nota.fecha)}`
                      : ""}
                  </span>
                  <strong>{nota.title}</strong>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="section-more-row">
      <SectionMoreArrow href="/motos" label="Ver el archivo de Motos" />
    </div>
  </div>
</section>
