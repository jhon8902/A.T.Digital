---
import { STATIC_SEARCH_ENTRIES } from "../../lib/search";

const headerSearchData = encodeURIComponent(
  JSON.stringify(STATIC_SEARCH_ENTRIES),
);
---

<header class="header">
  <!-- Identidad editorial (se desplaza al hacer scroll) -->
  <div class="brand-identity">
    <div class="brand-mark">
      <a href="/" class="brand-logo-frame" aria-label="Ir al inicio">
        <img
          src="/img/autlogo2.png"
          alt="AutoTech Digital"
          class="brand-logo"
          loading="eager"
          decoding="async"
        />
      </a>
      <p class="brand-tagline brand-tagline--mobile">
        <span class="brand-tagline-mobile-text">
          El automóvil, con criterio editorial.
        </span>
      </p>
    </div>
    <div class="brand-copy">
      <p class="brand-tagline brand-tagline--desktop">
        El automóvil, con criterio editorial.
      </p>
    </div>
  </div>

  <!-- Barra de navegación (queda fija al hacer scroll) -->
  <div class="top-bar-anchor" id="top-bar-anchor">
  <div class="top-bar" id="site-top-bar">
    <!-- Redes Sociales a la Izquierda -->
    <div class="header-social-icons">
      <a href="/contacto" class="fa-solid fa-envelope" aria-label="Contacto">
      </a>

      <a
        href="https://www.facebook.com/profile.php?id=61564010935908"
        class="fa-brands fa-facebook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"></a>
      <a
        href="https://www.instagram.com/autotechdigital/"
        class="fa-brands fa-instagram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"></a>
      <a
        href="https://www.tiktok.com/@autotechdigital"
        class="fa-brands fa-tiktok"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="TikTok"></a>
    </div>

    <div class="spacer"></div>

    <!-- Menú de navegación para escritorio -->
    <nav id="menu-escritorio" class="menu-escritorio" aria-label="Navegación principal">
      <ul>
        <li>
          <a href="/" class="nav-home">Inicio</a>
        </li>
        <li class="nav-dropdown nav-dropdown--tools">
          <button
            type="button"
            class="nav-dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Herramientas
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
          <ul class="nav-dropdown-menu">
            <li>
              <a href="/automatch">AutoMatch</a>
            </li>
            <li>
              <a href="/automatch/archivo">Catálogo de modelos</a>
            </li>
            <li>
              <a href="/automatch-find">Buscar auto para comprar</a>
            </li>
            <li>
              <a href="/calculadora-tco">Calculadora TCO</a>
            </li>
            <li>
              <a href="/concesionarios">Para concesionarios</a>
            </li>
          </ul>
        </li>
        <li>
          <a href="/#electricos" data-section="electricos">Eléctricos</a>
        </li>
        <li>
          <a href="/#hibridos" data-section="hibridos">Híbridos</a>
        </li>
        <li>
          <a href="/#noticias" data-section="noticias">Noticias</a>
        </li>
        <li class="nav-dropdown">
          <button
            type="button"
            class="nav-dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Secciones
            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
          </button>
          <ul class="nav-dropdown-menu">
            <li>
              <a href="/#lanzamientos" data-section="lanzamientos">Lanzamientos</a>
            </li>
            <li>
              <a href="/#pruebas" data-section="pruebas">Videos</a>
            </li>
            <li>
              <a href="/deportes">Autos deportivos</a>
            </li>
          </ul>
        </li>
      </ul>
    </nav>

    <div class="auth-buttons">
      <button id="search-button" class="fa-solid fa-magnifying-glass" aria-label="Buscar"></button>
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Busca marcas, modelos o categorias"
      />
      <button
        id="search-close"
        class="search-close"
        aria-label="Cerrar búsqueda">&times;</button
      >

      <button class="register-button">Registro</button>
    </div>
    <button
      id="boton-hamburguesa"
      class="boton-hamburguesa"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-hamburguesa"
    >
      <span class="boton-hamburguesa__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
  </div>

  <section id="inicio" aria-hidden="true"></section>

  <a
    href="/"
    id="boton-inicio"
    class="fa-solid fa-house boton-flotante boton-inicio"
    title="Volver al inicio"
    aria-label="Volver al inicio"></a>

  <button
    type="button"
    id="boton-subir"
    class="fa-solid fa-arrow-up boton-flotante boton-subir"
    title="Subir"
    aria-label="Subir al inicio de la página"></button>

  <!-- Menú hamburguesa para móvil -->
  <nav id="menu-hamburguesa" class="menu-hamburguesa">
    <div class="menu-overlay" id="menu-overlay"></div>
    <div class="menu-content">
      <div class="menu-drawer-head">
        <p class="menu-drawer-kicker">AutoTech Digital</p>
        <button
          id="close-menu"
          class="close-menu"
          type="button"
          aria-label="Cerrar menú"
        >
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="menu-mobile-actions">
        <button id="menu-search-button" type="button" class="menu-action-btn">
          Buscar
        </button>
        <a href="/registro" class="menu-action-link">Registro</a>
      </div>
      <ul>
        <li class="menu-mobile-group-label">Producto</li>
        <li>
          <a href="/automatch">AutoMatch</a>
        </li>
        <li>
          <a href="/automatch/archivo">Catálogo de modelos</a>
        </li>
        <li>
          <a href="/automatch-find">Buscar auto para comprar</a>
        </li>
        <li>
          <a href="/calculadora-tco">Calculadora TCO</a>
        </li>
        <li>
          <a href="/concesionarios">Para concesionarios</a>
        </li>

        <li class="menu-mobile-group-label">Explorar</li>
        <li><a href="/#electricos" data-section="electricos">Eléctricos</a></li>
        <li><a href="/#hibridos" data-section="hibridos">Híbridos</a></li>
        <li>
          <a href="/#lanzamientos" data-section="lanzamientos">Lanzamientos</a>
        </li>
        <li><a href="/#pruebas" data-section="pruebas">Videos</a></li>
        <li><a href="/#noticias" data-section="noticias">Noticias</a></li>

        <li class="menu-mobile-group-label">Sitio</li>
        <li><a href="/deportes">Autos deportivos</a></li>
        <li><a href="/">Inicio</a></li>
      </ul>
    </div>
  </nav>
</header>

<div id="header-search-data" data-search={headerSearchData} hidden></div>

<style>
  /* Reset de box-sizing para todos los elementos */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-anchor-offset, 120px);
  }

  [id] {
    scroll-margin-top: var(--header-anchor-offset, 120px);
  }

  /* Estilo principal del header */
  .header {
    position: relative;
    display: block;
    height: auto;
    width: 100%;
    background: black;
    font-family: var(--font-body);
    overflow: visible;
  }

  .top-bar-anchor {
    position: relative;
    width: 100%;
  }

  /* clase para redes sociales contenedor */

  .top-bar {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    gap: 12px;
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    z-index: 1200;
    background-color: #fff;
    overflow-x: clip;
    border-top: 0;
    box-shadow: none;
    margin: 0;
    border-bottom: 2px solid #e6b410;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .top-bar.is-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    border-bottom-color: #e6b410;
  }

  /* Empuja menú + acciones a la derecha */
  .top-bar .spacer {
    flex: 1 1 auto;
    min-width: 0.75rem;
  }

  /* Menú de escritorio */
  .menu-escritorio {
    display: none;
    margin-top: 0;
    text-align: center;
    flex-shrink: 1;
  }

  /* menu escritorio */
  .menu-escritorio ul {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.05rem;
  }

  .menu-escritorio ul li {
    margin: 0;
  }

  .menu-escritorio ul li a {
    position: relative;
    color: #08341f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 0.62rem;
    border-radius: 0;
    text-decoration: none;
    border: 0 !important;
    background: transparent;
    transition: color 0.2s ease;
  }

  .menu-escritorio ul li a:hover {
    background: transparent !important;
    color: var(--color-brand, #08341f);
    transform: none;
  }

  .menu-escritorio ul li a::after {
    content: "";
    position: absolute;
    left: 0.62rem;
    right: 0.62rem;
    bottom: 0.12rem;
    height: 2px;
    background: var(--color-accent, #e6b410);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .menu-escritorio ul li a:hover::after {
    transform: scaleX(1);
  }

  .menu-escritorio .nav-home {
    color: #08341f;
    font-weight: 700;
  }

  .menu-escritorio .nav-home:hover {
    background: transparent !important;
    color: var(--color-brand, #08341f);
  }

  .menu-escritorio .nav-primary {
    color: #08341f;
    font-weight: 700;
  }

  .menu-escritorio .nav-cta {
    background: var(--color-brand, #08341f);
    color: #fff !important;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: 999px;
  }

  .menu-escritorio .nav-cta:hover {
    background: var(--color-brand-hover, #0a4a2b) !important;
    color: #fff !important;
  }

  .menu-escritorio .nav-cta::after {
    display: none;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: none;
    background: transparent;
    color: #08341f;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.5rem 0.62rem;
    border-radius: 0;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s ease;
  }

  .nav-dropdown-toggle:hover,
  .nav-dropdown.is-open .nav-dropdown-toggle {
    background: transparent;
    color: var(--color-brand, #08341f);
  }

  .nav-dropdown-toggle::after {
    content: "";
    position: absolute;
    left: 0.62rem;
    right: 0.62rem;
    bottom: 0.12rem;
    height: 2px;
    background: var(--color-accent, #e6b410);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .nav-dropdown-toggle:hover::after,
  .nav-dropdown.is-open .nav-dropdown-toggle::after {
    transform: scaleX(1);
  }

  .nav-dropdown-toggle i {
    font-size: 0.65em;
    opacity: 0.7;
    transition: transform 0.2s ease;
  }

  .nav-dropdown.is-open .nav-dropdown-toggle i {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 50%;
    transform: translateX(-50%);
    min-width: 190px;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    z-index: 1300;
  }

  .nav-dropdown.is-open .nav-dropdown-menu,
  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav-dropdown-menu li {
    margin: 0 !important;
  }

  .nav-dropdown-menu a {
    display: block;
    padding: 0.65rem 0.85rem !important;
    border-radius: 6px;
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    white-space: nowrap;
    color: #08341f !important;
  }

  .nav-dropdown-menu a::after {
    display: none !important;
  }

  .nav-dropdown-menu a:hover {
    background: #f3f5f4 !important;
    color: var(--color-brand, #08341f) !important;
  }

  .menu-mobile-group-label {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.85rem 18px 0.15rem;
    margin-top: 0.15rem;
  }

  .menu-content .nav-primary {
    color: #f8ca26;
    font-weight: 700;
  }

  .menu-content .nav-cta {
    background: var(--color-brand, #08341f);
    color: #fff !important;
    font-weight: 700;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* Redes sociales — sutiles, logo en color de marca */
  .header-social-icons {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 1.08rem;
    border-bottom: none;
    flex-shrink: 0;
    padding-right: 14px;
    margin-right: 2px;
    border-right: 1px solid rgba(8, 52, 31, 0.12);
  }

  .header-social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    width: 34px;
    padding: 0;
    border-radius: 0;
    text-align: center;
    line-height: 1;
    text-decoration: none;
    background: transparent;
    border: 0;
    color: #08341f !important;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .header-social-icons a.fa-solid,
  .header-social-icons a.fas {
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
  }

  .header-social-icons a.fa-brands,
  .header-social-icons a.fab {
    font-family: "Font Awesome 6 Brands";
    font-weight: 400;
  }

  .header-social-icons a:hover {
    transform: none;
    border-color: transparent;
    box-shadow: none;
  }

  .header-social-icons a.fa-envelope,
  .header-social-icons a.fa-envelope:hover {
    color: #25d366 !important;
  }

  .header-social-icons a.fa-facebook,
  .header-social-icons a.fa-facebook:hover {
    color: #1877f2 !important;
  }

  .header-social-icons a.fa-instagram,
  .header-social-icons a.fa-instagram:hover {
    color: #e1306c !important;
  }

  .header-social-icons a.fa-tiktok,
  .header-social-icons a.fa-tiktok:hover {
    color: #111111 !important;
  }
  /* Botón hamburguesa */

  .boton-hamburguesa {
    color: #10161f;
    font-size: 16px;
    border: 1.5px solid #e6b410;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    padding: 0;
    flex-shrink: 0;
    background: #e6b410;
    border-radius: 0;
    transition: border-color 0.2s ease, background 0.2s ease;
    box-shadow: none;
    min-width: 44px;
    min-height: 44px;
  }

  .boton-hamburguesa:hover,
  .boton-hamburguesa:active {
    background: #c49a12;
    border-color: #c49a12;
    transform: none;
    box-shadow: none;
  }

  .boton-hamburguesa__bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 18px;
  }

  .boton-hamburguesa__bars span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: #08341f;
    border-radius: 1px;
  }

  .menu-hamburguesa {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 10000;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.45s;
  }

  .menu-hamburguesa.active {
    visibility: visible;
    pointer-events: auto;
    transition: visibility 0s;
  }

  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: rgba(10, 12, 11, 0.46);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .menu-hamburguesa.active .menu-overlay {
    opacity: 1;
  }

  .menu-content {
    position: fixed;
    top: 0;
    left: 0;
    width: min(84vw, 328px);
    max-width: 328px;
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    background: linear-gradient(165deg, #141414 0%, #1c1608 100%);
    border-right: 1px solid rgba(225, 163, 7, 0.22);
    box-shadow: 12px 0 40px rgba(0, 0, 0, 0.28);
    z-index: 2;
    padding: 22px 22px max(28px, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    transform: translateX(-100%);
    transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu-hamburguesa.active .menu-content {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-overlay,
    .menu-content {
      transition: none;
    }
  }

  .menu-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    flex-shrink: 0;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(225, 163, 7, 0.18);
  }

  .menu-drawer-kicker {
    margin: 0;
    font-family: var(--font-display, "Newsreader", Georgia, serif);
    font-style: normal;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: rgba(232, 236, 233, 0.92);
  }

  .close-menu {
    background: none;
    border: none;
    color: rgba(232, 236, 233, 0.72);
    font-size: 1.65rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 2px;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .close-menu:hover {
    color: #e6b410;
  }

  .menu-mobile-actions {
    display: none;
    flex-shrink: 0;
  }

  .menu-action-btn,
  .menu-action-link {
    border: 1.5px solid #e6b410;
    background: #e6b410;
    color: #10161f;
    border-radius: 0;
    padding: 10px 12px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .menu-action-btn:hover,
  .menu-action-link:hover {
    background: #c49a12;
    border-color: #c49a12;
    color: #10161f;
  }

  .menu-action-link {
    background: #e6b410;
    border-color: #e6b410;
    color: #10161f;
  }

  .menu-action-link:hover {
    background: #c49a12;
    border-color: #c49a12;
    color: #10161f;
  }

  .menu-content ul {
    list-style: none;
    padding: 0 0 1.25rem;
    margin: 0;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .menu-content ul li a {
    display: block;
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.02rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 11px 2px;
    border-radius: 0;
    text-decoration: none;
    text-transform: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: color 0.2s ease;
  }

  .menu-content ul li a:hover {
    background: transparent;
    color: #e6b410;
    transform: none;
  }
  @media (min-width: 1024px) {
    .menu-hamburguesa,
    .boton-hamburguesa {
      display: none !important;
    }
  }
  @media (max-width: 1023px) {
    .menu-hamburguesa {
      display: block;
    }
    .boton-hamburguesa {
      display: flex;
    }
  }

  /* Media query para pantallas pequeñas */
  @media (max-width: 600px) {
    .header {
      height: auto;
      min-height: 0;
    }
  }

  /* Media query para pantallas medianas */
  @media (min-width: 601px) and (max-width: 1024px) {
    .header {
      height: auto;
      min-height: 0;
    }
  }

  /* Responsive */
  @media (min-width: 768px) {
    .header {
      height: auto;
      min-height: 0;
    }

    .header-social-icons {
      gap: 2px;
    }

