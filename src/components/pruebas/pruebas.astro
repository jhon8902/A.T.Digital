---
import { resolveSiteNotes, type SiteNote } from "../../lib/api";
import { HOME_PRUEBAS_HOME_LIMIT } from "../../lib/home-news-config";
import {
  buildPruebaVideosFromNotes,
  slugPruebaTitle,
} from "../../lib/pruebas-videos";

interface Props {
  notes?: SiteNote[];
}

const { notes: prefetchedNotes } = Astro.props;

type PruebaItem = {
  noteId?: number;
  title: string;
  subtitle: string;
  video?: string;
  image?: string;
  href?: string;
  showNoteLink?: boolean;
  sortDate: number;
};

const staticPruebas: PruebaItem[] = [
  {
    title: "Ford F-150",
    subtitle:
      "La Ford F-150 es una pick-up que te brinda todo lo que necesitas para esos viajes fuera de la ciudad. Descubre la emoción de nuestro modelo estrella.",
    video: "/img/videos-pruebas/ford f-150.mp4",
    sortDate: new Date("2025-08-10").getTime(),
  },
  {
    title: "Xiaomi YU7",
    subtitle:
      "Diseño y tecnología en armonía, el carro de Xiaomi rompiendo récord como el más vendido en poco tiempo.",
    video: "/img/videos-pruebas/xiaomi YU7.mp4",
    sortDate: new Date("2025-08-09").getTime(),
  },
  {
    title: "Nissan Qashqai",
    subtitle:
      "Con nueva parrilla, la Nissan Qashqai nos sorprende con sus cambios en tecnología y seguridad.",
    video: "/img/videos-pruebas/nissan qashqai.mp4",
    sortDate: new Date("2025-08-08").getTime(),
  },
  {
    title: "Mazda Iconic",
    subtitle:
      "El diseño de este Mazda Iconic es muy moderno y elegante, destaca por sus líneas deportivas y detalles innovadores.",
    video: "/img/videos-pruebas/prueba-mazda.mp4",
    sortDate: new Date("2025-08-07").getTime(),
  },
  {
    title: "DFSK E5",
    subtitle:
      "La SUV eléctrica para 7 pasajeros, confortable y espaciosa, nos sorprendió mucho y seguro que a ustedes también les gustará.",
    video: "/img/videos-pruebas/video-dfsk.mp4",
    sortDate: new Date("2025-08-06").getTime(),
  },
  {
    title: "Kia K4 X-Line",
    subtitle:
      "La marca no quiere dejar los automóviles, por eso nos presenta el K4 Xline: deportivo, seguro y muy confortable.",
    video: "/img/videos-pruebas/video-kia-k4.mp4",
    sortDate: new Date("2025-08-05").getTime(),
  },
  {
    title: "Zeekr 007 GT",
    subtitle:
      "El ZEEKR 007 GT fue lanzado en China en abril del 2025 y a Europa llegará como 007 GT.",
    video: "/img/videos-pruebas/video-zeekr.mp4",
    sortDate: new Date("2025-08-04").getTime(),
  },
];

let dynamicPruebas: PruebaItem[] = [];

try {
  const data = await resolveSiteNotes(prefetchedNotes);

  if (data.length > 0) {
    dynamicPruebas = buildPruebaVideosFromNotes(data);
  }
} catch (err) {
  console.error("Error cargando pruebas dinámicas:", err);
}

const HOME_VISIBLE_COUNT = HOME_PRUEBAS_HOME_LIMIT;

function slugTitle(t?: string) {
  return slugPruebaTitle(t);
}

const dynamicPruebasTitles = new Set(
  dynamicPruebas.map((n) => slugTitle(n.title)),
);
const deduplicatedStaticPruebas = staticPruebas.filter(
  (n) => !dynamicPruebasTitles.has(slugTitle(n.title)),
);
const allPruebas = [...dynamicPruebas, ...deduplicatedStaticPruebas].sort(
  (a, b) => b.sortDate - a.sortDate,
);

const homePruebas = allPruebas.slice(0, HOME_VISIBLE_COUNT);
const first = homePruebas[0];
---

<link rel="stylesheet" href="/css/pruebas.css?v=27" />

<section
  id="pruebas"
  class="pruebas-section pruebas-section--videos"
  data-pruebas-channel
  aria-labelledby="pruebas-heading"
>
  <div class="pruebas-inner">
    <header class="pruebas-head">
      <p class="pruebas-eyebrow">
        <span class="pruebas-eyebrow__dot" aria-hidden="true"></span>
        Canal A.T. Digital
      </p>
      <h2 id="pruebas-heading" class="pruebas-title">
        <span class="pruebas-title__mark" aria-hidden="true"></span>
        Videos
      </h2>
    </header>

    {
      homePruebas.length > 0 && first && (
        <div class="pruebas-spotlight" data-pruebas-spotlight>
          <div class="pruebas-spotlight__stage">
            <div
              class="pruebas-spotlight__player"
              data-spotlight-media
              data-video-card
            >
              {first.video ? (
                <video
                  data-spotlight-video
                  playsinline
                  preload="metadata"
                  src={first.video}
                />
              ) : (
                <video
                  data-spotlight-video
                  playsinline
                  preload="metadata"
                  hidden
                />
              )}
              <img
                data-spotlight-image
                alt=""
                hidden={!first.image || !!first.video}
                src={first.image || undefined}
              />
              {!first.video && !first.image && (
                <div class="archivo-placeholder" data-spotlight-empty>
                  Sin video
                </div>
              )}
              <button
                type="button"
                class="prueba-play"
                data-spotlight-play
                aria-label={`Reproducir video de ${first.title}`}
                hidden={!first.video}
              />
            </div>

            <div class="pruebas-spotlight__meta">
              <div class="pruebas-spotlight__toolbar">
                <span
                  class="pruebas-spotlight__counter"
                  data-spotlight-counter
                  aria-live="polite"
                >
                  1 / {homePruebas.length}
                </span>
                <div
                  class="pruebas-spotlight__nav"
                  aria-label="Navegación de videos"
                >
                  <button
                    type="button"
                    class="pruebas-rail-btn prev"
                    data-spotlight-prev
                    aria-label="Video anterior"
                  >
                    <i class="fa-solid fa-chevron-left" aria-hidden="true" />
                  </button>
                  <button
                    type="button"
                    class="pruebas-rail-btn next"
                    data-spotlight-next
                    aria-label="Siguiente video"
                  >
                    <i class="fa-solid fa-chevron-right" aria-hidden="true" />
                  </button>
                </div>
              </div>

              <h3 class="pruebas-spotlight__title" data-spotlight-title>
                {first.title}
              </h3>
              <p class="pruebas-spotlight__desc" data-spotlight-desc>
                {first.subtitle}
              </p>
              <div class="pruebas-spotlight__actions" data-spotlight-actions>
                {first.showNoteLink && first.href && (
                  <a href={first.href} class="archivo-link" data-spotlight-note>
                    Ver nota
                  </a>
                )}
                <a href="/automatch-find" class="prueba-rail-automatch">
                  Comparar en AutoMatch
                </a>
              </div>
            </div>
          </div>

          <div
            class="pruebas-spotlight__thumbs"
            role="listbox"
            aria-label="Elegir video"
          >
            {homePruebas.map((prueba, index) => (
              <button
                type="button"
                class={`pruebas-spotlight__thumb${index === 0 ? " is-active" : ""}`}
                role="option"
                aria-selected={index === 0 ? "true" : "false"}
                data-spotlight-thumb
                data-index={String(index)}
                data-title={prueba.title}
                data-subtitle={prueba.subtitle}
                data-video={prueba.video || ""}
                data-image={prueba.image || ""}
                data-href={prueba.href || ""}
                data-show-note={prueba.showNoteLink ? "1" : "0"}
              >
                <span class="pruebas-spotlight__thumb-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="pruebas-spotlight__thumb-label">{prueba.title}</span>
              </button>
            ))}
          </div>
        </div>
      )
    }

    <div class="pruebas-footer">
      <a href="/pruebas" class="pruebas-more">
        Ver más videos
        <i class="fa-solid fa-arrow-right" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

<script type="module" src="/js/pruebas-channel.js?v=8"></script>
