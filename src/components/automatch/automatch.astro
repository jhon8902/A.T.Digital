---
import AutoMatchCard from "./AutoMatchCard.astro";

const {
  autos: incomingAutos = [],
  mode = "home",
  /** En el home del sitio: h2 + copy más suave (producto en evolución). */
  embedded = false,
} = Astro.props;
const HOME_VISIBLE_COUNT = 3;
const TitleTag = embedded ? "h2" : "h1";

function stripHtml(input = "") {
  return String(input)
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function formatCardPrecio(value?: number) {
  if (!value || value <= 0) return "";
  return new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  }).format(value);
}

function formatCondicionLabel(value?: string) {
  const key = String(value || "nuevo").toLowerCase();
  if (key === "seminuevo") return "Seminuevo";
  if (key === "usado") return "Usado";
  return "Nuevo";
}

const normalizedIncoming = Array.isArray(incomingAutos)
  ? incomingAutos
      .map((auto, index) => {
        const images = Array.isArray(auto?.imagenes)
          ? auto.imagenes.filter(Boolean)
          : [];
        return {
          id: String(auto?.id ?? `auto-${index + 1}`),
          nombre: String(auto?.nombre || "AutoMatch"),
          descripcion: String(
            auto?.descripcion || stripHtml(auto?.content || ""),
          ),
          imagenes: images.length > 0 ? images : ["/img/default.jpg"],
          href: String(auto?.href || "/automatch-find"),
          toolHref: String(auto?.toolHref || "/automatch-find"),
          ctaLabel: String(auto?.ctaLabel || "Infórmate antes de comprar"),
          toolCtaLabel: String(auto?.toolCtaLabel || "Usar AutoMatch"),
          catalogId: auto?.catalogId,
          noteId: auto?.noteId,
          condicion: String(auto?.condicion || "nuevo"),
          condicionLabel: formatCondicionLabel(auto?.condicion),
          carroceria: String(auto?.carroceria || ""),
          precio:
            typeof auto?.precio === "number" && auto.precio > 0
              ? auto.precio
              : 0,
          precioLabel: formatCardPrecio(
            typeof auto?.precio === "number" ? auto.precio : undefined,
          ),
        };
      })
      .filter((auto) => auto.nombre && auto.imagenes.length > 0)
  : [];

const mergedAutos = normalizedIncoming;

const autosToRender = mergedAutos;

const catalogFilters = [
  { id: "todos", label: "Todos" },
  { id: "nuevo", label: "Nuevos" },
  { id: "seminuevo", label: "Seminuevos" },
  { id: "usado", label: "Usados" },
];

const bodyFilters = [
  { id: "todos", label: "Todas" },
  { id: "sedan", label: "Sedán" },
  { id: "hatchback", label: "Hatchback" },
  { id: "suv", label: "SUV" },
  { id: "pickup", label: "Pick-up" },
  { id: "van", label: "Van" },
];

const priceFilters = [
  { id: "todos", label: "Todos" },
  { id: "50-90", label: "$50 – $90 mill." },
  { id: "91-149", label: "$91 – $149 mill." },
  { id: "hasta-150", label: "Hasta $150 mill." },
  { id: "150-250", label: "$150 – $250 mill." },
  { id: "mas-250", label: "Más de $250 mill." },
];

const searchCtaLabel = "Buscar auto para comprar";
---

{
  mode === "home" ? (
    <div class:list={["automatch-home", embedded && "automatch-home--embedded"]}>
      <header class="automatch-hero">
        <p class="automatch-hero__eyebrow">
          {embedded
            ? "Herramienta en evolución · Colombia"
            : "Herramienta inteligente · Colombia"}
        </p>
        <TitleTag class="automatch-hero__title">
          Encuentra tu auto ideal con <span>AutoMatch</span>
        </TitleTag>
        <p class="automatch-hero__lead">
          {embedded
            ? "Compara modelos, mira fichas y pide test drive. El catálogo sigue creciendo con datos de concesionarios."
            : "Compara autos nuevos, seminuevos y usados en Colombia. Elige cómo quieres empezar:"}
        </p>

        <div class="automatch-hero__paths">
          <div class="automatch-hero__path">
            <p class="automatch-hero__path-label">¿Ya sabes qué buscas?</p>
            <p class="automatch-hero__path-desc">
              Explora el catálogo con fotos, precios y datos de cada modelo.
            </p>
            <div class="automatch-hero__path-cta">
              <a
                href="#automatch-destacados"
                class="btn-automatch btn-automatch--primary btn-automatch--path"
              >
                <i class="fa-solid fa-car-side" aria-hidden="true"></i>
                Explorar catálogo
              </a>
              <p class="automatch-hero__path-note automatch-hero__path-note--spacer" aria-hidden="true"></p>
            </div>
          </div>

          <div class="automatch-hero__path">
            <p class="automatch-hero__path-label">¿Aún no?</p>
            <p class="automatch-hero__path-desc">
              Responde unas preguntas y te sugerimos opciones según tu perfil.
            </p>
            <div class="automatch-hero__path-cta">
              <a
                href="/automatch-find"
                class="btn-automatch btn-automatch--primary btn-automatch--path"
              >
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                {searchCtaLabel}
              </a>
              <p class="automatch-hero__path-note">Gratis · menos de 1 minuto</p>
            </div>
          </div>
        </div>

      </header>

      <section
        class="automatch-section automatch-section--cards"
        id="automatch-destacados"
        data-filter-limit={String(HOME_VISIBLE_COUNT)}
      >
        <div class="automatch-cards-intro">
          <p class="automatch-cards-kicker">Catálogo</p>
          {embedded ? (
            <h3 class="automatch-cards-heading">Autos destacados</h3>
          ) : (
            <h2 class="automatch-cards-heading">Autos destacados</h2>
          )}
          <p class="automatch-cards-lead">
            Filtra por carrocería y precio. Entra a la ficha si ya sabes el modelo.
          </p>
        </div>

        <div class="catalog-filters-stack">
          <div class="catalog-filter-group">
            <p class="catalog-filter-label">Categoría</p>
            <div
              class="catalog-filters"
              data-filter-type="carroceria"
              role="tablist"
              aria-label="Filtrar por carrocería"
            >
              {
                bodyFilters.map((filter, index) => (
                  <button
                    type="button"
                    class={`catalog-filter ${index === 0 ? "is-active" : ""}`}
                    data-filter={filter.id}
                    role="tab"
                    aria-selected={index === 0 ? "true" : "false"}
                  >
                    {filter.label}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="catalog-filter-group">
            <p class="catalog-filter-label">Precio</p>
            <div
              class="catalog-filters"
              data-filter-type="precio"
              role="tablist"
              aria-label="Filtrar por precio"
            >
              {
                priceFilters.map((filter, index) => (
                  <button
                    type="button"
                    class={`catalog-filter ${index === 0 ? "is-active" : ""}`}
                    data-filter={filter.id}
                    role="tab"
                    aria-selected={index === 0 ? "true" : "false"}
                  >
                    {filter.label}
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <p class="catalog-empty" hidden>
          No hay modelos en esta combinación por ahora.
        </p>

        <div class="cards">
          {
            autosToRender.map((auto: any, index: number) => (
              <AutoMatchCard
                auto={auto}
                startHidden={index >= HOME_VISIBLE_COUNT}
              />
            ))
          }
        </div>

        <div class="automatch-section__footer">
          <a href="/automatch/archivo" class="btn-automatch btn-automatch--primary btn-automatch--footer">
            <i class="fas fa-th-large" aria-hidden="true"></i>
            Ver catálogo completo
          </a>
          <a href="/automatch-find" class="btn-automatch btn-automatch--ver-mas">
            {searchCtaLabel}
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </section>
    </div>
  ) : (
    <section class="automatch-section automatch-section--catalog">
      <h2 class="titulo">
        <i class="fas fa-car titulo-icon"></i>
        Catálogo de modelos
      </h2>
      <p class="subtitulo">
        Filtra por condición, carrocería y precio para encontrar el modelo que
        quieres consultar.
      </p>

      <div class="catalog-filters-stack">
        <div class="catalog-filter-group">
          <p class="catalog-filter-label">Condición</p>
          <div
            class="catalog-filters"
            data-filter-type="condicion"
            role="tablist"
            aria-label="Filtrar por condición"
          >
            {
              catalogFilters.map((filter, index) => (
                <button
                  type="button"
                  class={`catalog-filter ${index === 0 ? "is-active" : ""}`}
                  data-filter={filter.id}
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {filter.label}
                </button>
              ))
            }
          </div>
        </div>
        <div class="catalog-filter-group">
          <p class="catalog-filter-label">Categoría</p>
          <div
            class="catalog-filters"
            data-filter-type="carroceria"
            role="tablist"
            aria-label="Filtrar por carrocería"
          >
            {
              bodyFilters.map((filter, index) => (
                <button
                  type="button"
                  class={`catalog-filter ${index === 0 ? "is-active" : ""}`}
                  data-filter={filter.id}
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {filter.label}
                </button>
              ))
            }
          </div>
        </div>
        <div class="catalog-filter-group">
          <p class="catalog-filter-label">Precio</p>
          <div
            class="catalog-filters"
            data-filter-type="precio"
            role="tablist"
            aria-label="Filtrar por precio"
          >
            {
              priceFilters.map((filter, index) => (
                <button
                  type="button"
                  class={`catalog-filter ${index === 0 ? "is-active" : ""}`}
                  data-filter={filter.id}
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {filter.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <p class="catalog-empty" hidden>No hay modelos en esta combinación por ahora.</p>

      <div class="cards">
        {autosToRender.map((auto: any) => <AutoMatchCard auto={auto} />)}
      </div>

      {
        autosToRender.length === 0 && (
          <p class="subtitulo">Aún no hay más modelos para mostrar.</p>
        )
      }

      <div class="automatch-section__footer automatch-section__footer--catalog">
        <a href="/automatch-find" class="btn-automatch btn-automatch--primary btn-automatch--footer">
          <i class="fa-solid fa-sliders" aria-hidden="true"></i>
          {searchCtaLabel}
        </a>
        <a href="/" class="btn-automatch btn-automatch--ver-mas">
          Volver al inicio
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
        </a>
      </div>
    </section>
  )
}

<style>
  /* ========== HERO HOME ========== */
  .automatch-home {
    width: 100%;
    background:
      radial-gradient(ellipse 80% 60% at 50% -10%, rgba(230, 180, 16, 0.18), transparent),
      linear-gradient(165deg, #062818 0%, #08341f 45%, #0a4228 100%);
  }

  .automatch-hero {
    text-align: center;
    width: min(96%, 1760px);
    margin-inline: auto;
    padding: clamp(2.25rem, 4.5vw, 3.5rem) clamp(1rem, 4vw, 2rem)
      clamp(2.5rem, 4vw, 3rem);
    color: #fff;
    position: relative;
    background: transparent;
    border-bottom: none;
  }

  .automatch-hero__eyebrow {
    font-family: var(--font-body, "Source Sans 3", sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0c14a;
    margin: 0 0 0.85rem;
  }

  .automatch-hero__title {
    font-family: var(--font-editorial, "Georgia", serif);
    font-size: clamp(2rem, 4.5vw, 3.35rem);
    font-weight: 700;
    line-height: 1.12;
    margin: 0 auto 1rem;
    max-width: 18ch;
    letter-spacing: 0.01em;
    color: #ffffff !important;
  }

  .automatch-hero__title span {
    color: #f0c14a !important;
  }

  .automatch-home--embedded .automatch-hero {
    padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-bottom: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .automatch-home--embedded .automatch-hero__title {
    font-size: clamp(1.85rem, 3.8vw, 2.75rem);
    max-width: 22ch;
  }

  .automatch-home--embedded .automatch-hero__lead {
    margin-bottom: 1.25rem;
  }

  .automatch-hero__lead {
    font-family: var(--font-body, "Source Sans 3", sans-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.88);
    max-width: 42rem;
    margin: 0 auto 1.75rem;
  }

  .automatch-hero__paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 52rem;
    margin: 0 auto;
    text-align: left;
  }

  .automatch-hero__path {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(240, 193, 74, 0.42);
    background: rgba(240, 193, 74, 0.08);
  }

  .automatch-hero__path-label {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    color: #f0c14a;
    font-family: var(--font-body, "Source Sans 3", sans-serif);
  }

  .automatch-hero__path-desc {
    margin: 0 0 0.35rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
    flex: 1;
  }

  .automatch-hero__path-cta {
    display: flex;
    flex-direction: column;
    margin-top: auto;
  }

  .automatch-hero__path-note {
    margin: 0.15rem 0 0;
    min-height: 1.25em;
    font-size: 0.82rem;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.65);
  }

  .btn-automatch--path {
    width: 100%;
    min-height: 3.15rem;
    justify-content: center;
    margin-top: 0;
    box-sizing: border-box;
  }

  .automatch-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem 1rem;
  }

  .btn-automatch--hero {
    padding: 1rem 1.85rem;
    font-size: 1.02rem;
    background: #f0c14a;
    color: #08341f;
    border-color: #f0c14a;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  .btn-automatch--hero:hover {
    background: #ffd966;
    border-color: #ffd966;
    color: #062818;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .btn-automatch--ghost {
    padding: 0.95rem 1.35rem;
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 600;
    box-shadow: none;
  }

  .btn-automatch--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.85);
    color: #fff;
    transform: translateY(-1px);
  }

  .btn-automatch--ghost.btn-automatch--path {
    margin-top: 0;
  }

  #automatch-destacados {
    scroll-margin-top: 6rem;
  }

  .titulo--cards {
    font-size: clamp(1.65rem, 2.5vw, 2.1rem);
  }

  /* Intro y filtros centrados; la grilla de fichas queda centrada en la página */
  .automatch-cards-intro {
    width: min(68rem, 100%);
    max-width: 68rem;
    margin: 0 auto 1.15rem;
    text-align: center;
    padding: 0 0.15rem;
  }

  .automatch-cards-kicker {
    margin: 0 0 0.4rem !important;
    font-family: var(--font-body, "Source Sans 3", sans-serif) !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #6b7a70 !important;
  }

  .automatch-cards-heading {
    margin: 0 0 0.45rem !important;
    font-family: var(--font-body, "Source Sans 3", sans-serif) !important;
    font-size: clamp(1.45rem, 2.1vw, 1.75rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.01em !important;
    line-height: 1.22 !important;
    color: #062818 !important;
    display: block !important;
    gap: 0 !important;
    text-align: center !important;
  }

  .automatch-cards-heading::before,
  .automatch-cards-heading::after {
    content: none !important;
    display: none !important;
  }

  .automatch-cards-lead {
    margin: 0 !important;
    font-family: var(--font-body, "Source Sans 3", sans-serif) !important;
    font-size: clamp(1.02rem, 1.35vw, 1.12rem) !important;
    line-height: 1.55 !important;
    color: #5a6470 !important;
    text-align: center !important;
    max-width: 42rem;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .automatch-home--embedded .automatch-cards-intro {
    margin-bottom: 0.9rem;
  }

  /* ========== SECCIÓN AUTOMATCH PRINCIPAL ========== */

  .automatch-section {
    text-align: center;
    padding: 3rem 1rem;
    background: #ffffff;
    border-radius: 1.2rem;
    margin: 3rem 0;
    font-size: 1.4rem;
    box-shadow: 0 8px 32px rgba(225, 163, 7, 0.1);
    animation: slideInSection 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Home: pegado al hero (debe ir después de .automatch-section) */
  .automatch-section.automatch-section--cards {
    width: min(96%, 1760px);
    margin: 0 auto !important;
    border-radius: 0;
    box-shadow: none;
    background-color: var(--home-section-bg, #f0f3f0);
    background-image: var(--home-relief-image);
    background-size: var(--home-relief-size);
    background-repeat: repeat;
    padding: clamp(1.35rem, 2.5vw, 1.85rem) 1rem clamp(2rem, 4vw, 2.75rem);
    animation: none;
    text-align: left;
  }

  .automatch-home--embedded .automatch-section.automatch-section--cards {
    padding-top: clamp(1.1rem, 2vw, 1.45rem);
  }

  @keyframes slideInSection {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .automatch-section h2 {
    font-size: 3.2rem;
    color: #08341f;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .automatch-section p {
    color: #1f1f1f;
    font-size: 1.4rem;
    margin-bottom: 2rem;
  }

  /* ========== TÍTULO CON LÍNEAS ========== */
  .titulo {
    font-size: 2.4rem;
    font-weight: 700;
    color: #02350f;
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
  }

  .titulo-icon {
    font-size: 2rem;
    color: #08341f;
    opacity: 0.85;
  }

  .titulo::before,
  .titulo::after {
    content: "";
    flex: 1;
    height: 2px;
    background-color: #1b5e3f;
    max-width: 650px;
  }

  .subtitulo {
    color: #555;
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  /* ========== GRID DE TARJETAS ========== */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem 1.2rem;
    max-width: 68rem;
    margin: 0 auto 1.5rem;
    font-size: 1rem;
    text-align: start;
  }

  /* ========== BOTÓN AUTOMATCH ========== */
  .ver-mas-automatch-container {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .automatch-section__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.85rem 1rem;
    margin-top: 1.75rem;
    padding-top: 0.5rem;
  }

  .btn-automatch--footer {
    margin-top: 0;
    padding: 0.9rem 1.5rem;
    background: #08341f;
    color: #fff;
    border: 1px solid #08341f;
    border-radius: 999px;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0.01em;
    box-shadow: 0 8px 20px rgba(8, 52, 31, 0.2);
  }

  .btn-automatch--footer:hover {
    background: #0a4228;
    border-color: #0a4228;
    color: #fff;
  }

  .automatch-section--catalog {
    background: #f4f5f7;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
    padding-top: clamp(2rem, 4vw, 2.75rem);
  }

  .catalog-filters-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0 auto 1.35rem;
    max-width: 68rem;
    width: min(68rem, 100%);
    align-items: center;
  }

  .catalog-filter-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .catalog-filter-label {
    margin: 0;
    font-family: var(--font-body, "Source Sans 3", sans-serif);
    font-size: 0.88rem !important;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5c6b62 !important;
  }

  .automatch-section .catalog-filter-label {
    margin-bottom: 0;
  }

  /* Filtros editoriales: texto + / (sin pastillas) */
  .catalog-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0;
    margin: 0;
    max-width: none;
  }

  .catalog-filter {
    border: none;
    background: transparent;
    color: #3d4a42;
    border-radius: 0;
    padding: 0.32rem 0;
    font-size: clamp(1.18rem, 1.65vw, 1.38rem);
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-body, "Source Sans 3", sans-serif);
