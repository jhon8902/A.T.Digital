</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".auto-img").forEach((img) => {
      const htmlImg = img as HTMLImageElement;
      if (htmlImg.complete && htmlImg.naturalWidth > 0) {
        htmlImg.closest(".auto-carousel")?.classList.add("loaded");
      }
      htmlImg.addEventListener("load", () => {
        htmlImg.closest(".auto-carousel")?.classList.add("loaded");
      });
    });

    function animateImageEntry(imageEl: HTMLElement | undefined) {
      if (!imageEl) return;
      imageEl.classList.remove("entering");
      void imageEl.offsetWidth;
      imageEl.classList.add("entering");
    }

    function getCurrentImageIndex(images: Element[]) {
      const current = images.findIndex((img) =>
        img.classList.contains("visible"),
      );
      return current < 0 ? 0 : current;
    }

    function updateCarousel(card: HTMLElement, nextIndex: number) {
      const carousel = card.querySelector(".auto-carousel");
      if (!(carousel instanceof HTMLElement)) return;

      carousel.classList.add("loaded");
      const images = Array.from(carousel.querySelectorAll(".auto-img"));
      const dots = Array.from(card.querySelectorAll(".carousel-dot"));
      if (images.length === 0) return;

      const current = getCurrentImageIndex(images);
      const normalizedNext =
        ((nextIndex % images.length) + images.length) % images.length;

      images[current]?.classList.remove("visible");
      images[current]?.classList.add("hidden");
      images[current]?.classList.remove("entering");

      images[normalizedNext]?.classList.remove("hidden");
      images[normalizedNext]?.classList.add("visible");
      animateImageEntry(images[normalizedNext] as HTMLElement | undefined);

      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === normalizedNext);
      });

      const counter = card.querySelector(".carousel-counter");
      if (counter) {
        counter.textContent = `${normalizedNext + 1} / ${images.length}`;
      }
    }

    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      if (
        target.matches(".carousel-nav, .carousel-dot") ||
        target.closest(".carousel-nav")
      ) {
        const trigger = target.matches(".carousel-nav, .carousel-dot")
          ? target
          : target.closest(".carousel-nav");
        if (!(trigger instanceof HTMLElement)) return;

        const card = trigger.closest(".auto-card");
        if (!(card instanceof HTMLElement)) return;
        const images = Array.from(
          card.querySelectorAll(".auto-carousel .auto-img"),
        );
        if (images.length === 0) return;

        const current = getCurrentImageIndex(images);

        let nextIndex = current;
        if (trigger.matches(".next")) {
          nextIndex = (current + 1) % images.length;
        } else if (trigger.matches(".prev")) {
          nextIndex = (current - 1 + images.length) % images.length;
        } else if (trigger.matches(".carousel-dot")) {
          const dotIndex = Number(trigger.dataset.index);
          if (
            !Number.isNaN(dotIndex) &&
            dotIndex >= 0 &&
            dotIndex < images.length
          ) {
            nextIndex = dotIndex;
          }
        }

        updateCarousel(card, nextIndex);
      }
    });

    const catalogSection = document.querySelector(".automatch-section--catalog");
    const homeSection = document.querySelector(".automatch-section--cards");

    function precioMatches(precioValue: string, band: string) {
      if (band === "todos") return true;
      const precio = Number(precioValue) || 0;
      if (!precio) return false;
      if (band === "50-90") return precio >= 50_000_000 && precio < 91_000_000;
      if (band === "91-149") return precio >= 91_000_000 && precio < 150_000_000;
      if (band === "hasta-150") return precio < 150_000_000;
      if (band === "150-250") return precio >= 150_000_000 && precio < 250_000_000;
      if (band === "mas-250") return precio >= 250_000_000;
      return true;
    }

    function setupCardFilters(section: Element | null) {
      if (!(section instanceof HTMLElement)) return;

      const cards = section.querySelectorAll(".auto-card");
      const emptyState = section.querySelector(".catalog-empty");
      const limit = Number(section.dataset.filterLimit) || 0;
      const state: Record<string, string> = {
        condicion: "todos",
        carroceria: "todos",
        precio: "todos",
      };

      const params = new URLSearchParams(window.location.search);
      ["condicion", "carroceria", "precio"].forEach((key) => {
        const value = params.get(key);
        if (
          value &&
          section.querySelector(
            `[data-filter-type="${key}"] [data-filter="${value}"]`,
          )
        ) {
          state[key] = value;
        }
      });

      function activateGroup(type: string, id: string) {
        const group = section.querySelector(`[data-filter-type="${type}"]`);
        if (!group) return;
        group.querySelectorAll(".catalog-filter").forEach((button) => {
          const isActive = button.getAttribute("data-filter") === id;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-selected", isActive ? "true" : "false");
        });
      }

      function applyFilters() {
        const filtersActive =
          state.condicion !== "todos" ||
          state.carroceria !== "todos" ||
          state.precio !== "todos";
        const cap = !filtersActive && limit > 0 ? limit : Number.POSITIVE_INFINITY;
        let visibleCount = 0;

        cards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const condicion = card.getAttribute("data-condicion") || "nuevo";
          const carroceria = card.getAttribute("data-carroceria") || "";
          const precio = card.getAttribute("data-precio") || "";
          const match =
            (state.condicion === "todos" || condicion === state.condicion) &&
            (state.carroceria === "todos" || carroceria === state.carroceria) &&
            precioMatches(precio, state.precio);
          const show = match && visibleCount < cap;
          if (show) visibleCount += 1;
          card.hidden = !show;
          card.classList.toggle("is-hidden", !show);
        });

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount > 0;
        }
      }

      section.querySelectorAll("[data-filter-type]").forEach((group) => {
        const type = group.getAttribute("data-filter-type") || "";
        if (!type || !(type in state)) return;

        activateGroup(type, state[type]);

        group.querySelectorAll(".catalog-filter").forEach((button) => {
          button.addEventListener("click", () => {
            const filterId = button.getAttribute("data-filter") || "todos";
            state[type] = filterId;
            activateGroup(type, filterId);
            applyFilters();
          });
        });
      });

      applyFilters();
    }

    setupCardFilters(homeSection);
    setupCardFilters(catalogSection);
  });
</script>
