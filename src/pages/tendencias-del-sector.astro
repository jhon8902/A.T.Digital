---
import Layout from "../layouts/Layout.astro";
import TrendCard from "../components/sector-radar/TrendCard.astro";
import {
  sectorRadarActive,
  sectorRadarArchive,
  sectorRadarSource,
  sectorRadarTrends,
} from "../lib/sector-radar";

const trends = sectorRadarTrends;
---

<Layout title="Tendencias del sector" bodyClass="tendencias-page">
  <section class="tendencias-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 class="hero-kicker">Radar del sector</h1>
        <p class="hero-edition">{sectorRadarActive.focusLabel ?? sectorRadarActive.label}</p>
      </div>
    </div>
  </section>

  <section id="tendencias-grid" class="tendencias-grid">
    {trends.map((trend) => <TrendCard trend={trend} />)}
    <p class="tendencias-source">
      <strong>{sectorRadarSource.label}:</strong> {sectorRadarSource.text}
    </p>
  </section>

  {
    sectorRadarArchive.length > 0 && (
      <section id="tendencias-archivo" class="tendencias-archivo">
        <div class="tendencias-archivo-inner">
          <h2>Ediciones anteriores</h2>
          <p class="tendencias-archivo-lead">
            Cada actualización queda registrada con su fecha y fuente para que
            puedas contrastar cómo evolucionan las señales del mercado.
          </p>
          {sectorRadarArchive.map((edition) => (
            <details class="tendencias-archive-item">
              <summary>
                <span class="tendencias-archive-title">{edition.label}</span>
                <span class="tendencias-archive-period">{edition.period}</span>
              </summary>
              <div class="tendencias-archive-body">
                <p class="tendencias-source tendencias-source--archive">
                  <strong>{edition.source.label}:</strong> {edition.source.text}
                </p>
                <div class="tendencias-grid tendencias-grid--archive">
                  {edition.trends.map((trend) => (
                    <TrendCard trend={trend} heading="h3" archive />
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }

  <section class="tendencias-cta">
    <div class="cta-content">
      <h3>Estas cifras tienen modelo</h3>
      <p>En las notas está el carro detrás de estas matrículas.</p>
      <a class="cta-primary" href="/#noticias">Ir a noticias</a>
    </div>
  </section>
</Layout>

<style>
  .tendencias-hero {
    background: #08341f;
    color: #f8fafc;
    padding: clamp(2.2rem, 4vw, 2.8rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1.8rem, 3vw, 2.3rem);
  }

  .hero-inner {
    width: min(100%, 1440px);
    margin: 0 auto;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.2;
    color: #f8ca26 !important;
    font-family: "Source Sans 3", sans-serif;
  }

  .hero-edition {
    margin: 0;
    font-family: var(--font-display, "Newsreader", Georgia, serif);
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    color: #f8fafc;
  }

  .cta-primary,
  .cta-secondary {
    text-decoration: none;
    font-weight: 700;
    padding: 12px 26px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cta-primary {
    background: #f8ca26;
    color: #1a1a1a;
    box-shadow: 0 12px 24px rgba(248, 202, 38, 0.25);
  }

  .cta-secondary {
    border: 1px solid rgba(248, 202, 38, 0.6);
    color: #f8ca26;
  }

  .cta-primary:hover,
  .cta-secondary:hover {
    transform: translateY(-2px);
  }

  .tendencias-grid {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: clamp(2.4rem, 4vw, 3.4rem) clamp(1.25rem, 3vw, 2.5rem) clamp(2.6rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
    background: transparent;
  }

  @media (min-width: 800px) {
    .tendencias-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .tendencias-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem 1.15rem;
    }
  }

  .tendencias-source {
    grid-column: 1 / -1;
    margin: 8px 0 0;
    padding: 18px 20px;
    border-radius: 12px;
    background: rgba(8, 52, 31, 0.05);
    border: 1px solid rgba(8, 52, 31, 0.08);
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(26, 26, 26, 0.75);
    font-family: "Poppins", sans-serif;
  }

  .tendencias-source strong {
    color: #08341f;
    font-weight: 700;
  }

  .tendencias-archivo {
    padding: 0 clamp(1.25rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 3.5rem);
    background: #f7f4ec;
  }

  .tendencias-archivo-inner {
    width: min(100%, 1440px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tendencias-archivo h2 {
    margin: 0;
    font-family: var(--font-display, "Newsreader", Georgia, serif);
    font-weight: 600;
    font-size: clamp(1.65rem, 2.2vw, 2.05rem);
    color: #08341f;
  }

  .tendencias-archivo-lead {
    margin: 0;
    max-width: 62ch;
    font-family: "Source Sans 3", sans-serif;
    font-size: 1.02rem;
    line-height: 1.55;
    color: #3d4a42;
  }

  .tendencias-archive-item {
    border: 1px solid rgba(8, 52, 31, 0.1);
    border-radius: 16px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(17, 24, 39, 0.04);
  }

  .tendencias-archive-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    padding: 18px 22px;
    font-family: "Poppins", sans-serif;
  }

  .tendencias-archive-item summary::-webkit-details-marker {
    display: none;
  }

  .tendencias-archive-item summary::after {
    content: "+";
    font-size: 1.35rem;
    font-weight: 700;
    color: #d4a742;
    line-height: 1;
  }

  .tendencias-archive-item[open] summary::after {
    content: "−";
  }

  .tendencias-archive-title {
    font-weight: 700;
    color: #08341f;
    font-size: 1.05rem;
  }

  .tendencias-archive-period {
    color: rgba(26, 26, 26, 0.62);
    font-size: 0.92rem;
  }

  .tendencias-archive-body {
    padding: 0 22px 22px;
    border-top: 1px solid rgba(8, 52, 31, 0.08);
  }

  .tendencias-source--archive {
    margin: 18px 0 20px;
  }

  .tendencias-grid--archive {
    padding: 0;
    background: transparent;
    gap: 20px;
  }

  :global(body.tendencias-page) {
    background: #f7f4ec;
  }

  .tendencias-cta {
    padding: 0.5rem clamp(1.25rem, 3vw, 2.5rem) clamp(3rem, 6vw, 4.5rem);
    background: #f7f4ec;
  }

  .cta-content {
    max-width: 40rem;
    margin: 0 auto;
    background: #08341f;
    border: none;
    border-top: 3px solid #e6b410;
    box-shadow: none;
    border-radius: 0;
    padding: 2rem 1.75rem 1.85rem;
    color: #f8fafc;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-content h3 {
    margin: 0;
    font-size: clamp(1.45rem, 2vw, 1.75rem);
    font-family: var(--font-display, "Newsreader", Georgia, serif);
    font-weight: 600;
    color: #f8fafc !important;
  }

  .cta-content p {
    margin: 0;
    color: rgba(248, 250, 252, 0.88);
    font-family: "Source Sans 3", sans-serif;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .tendencias-hero h1 {
      max-width: none;
    }

    .tendencias-grid {
      padding: 40px 18px 48px;
      gap: 22px;
    }

    .cta-content {
      padding: 32px 24px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .tendencias-hero h1 {
      font-size: 2.15rem;
      line-height: 1.12;
    }

    .hero-copy p {
      font-size: 1.02rem;
      line-height: 1.55;
    }
  }
</style>
