---
import { resolveSiteNotes } from "../lib/api";
import Layout from "../layouts/Layout.astro";
import SectionInfo from "../components/Section-Info/Section-Info.astro";
import Hibridos from "../components/hibridos/hibridos.astro";
import Noticias from "../components/section-noticias/noticias.astro";
import Electricos from "../components/electricos/Electricos.astro";
import Deportes from "../components/deportes/deportes.astro";
import Pruebas from "../components/pruebas/pruebas.astro";
import AutoMatch from "../components/automatch/automatch.astro";
import AutoMatchPromo from "../components/automatch/AutoMatchPromo.astro";
import {
  buildAutomatchCarousel,
  type AutomatchDbNote,
} from "../lib/automatch-catalog";
// import AdBanner from "../components/advertising/AdBanner.astro";

let homeNotes = await resolveSiteNotes();

const automatchNotes: AutomatchDbNote[] = homeNotes
  .filter((note) => note.category?.toLowerCase() === "automatch")
  .map((note) => ({
    id: note.id,
    title: note.title,
    subtitle: note.subtitle,
    content: note.content || "",
    created_at: note.created_at,
    image1: note.image1,
    image2: note.image2,
    image3: note.image3,
    image4: note.image4,
    image5: note.image5,
    image6: note.image6,
  }));

const automatchAutos = buildAutomatchCarousel(automatchNotes, {
  skipEditorialCover: true,
});
---

<Layout
  title="Auto-Tech-Digital | Eléctricos, híbridos y noticias del mundo automotriz"
  description="Lanzamientos, fichas técnicas, eléctricos, híbridos y pruebas de manejo. Cobertura del sector automotor con mirada global."
  class="home-page"
>
  <div class="extra-sections" id="extra-sections">
    <SectionInfo notes={homeNotes} />

    <section id="automatch" class="automatch-destacado" aria-label="AutoMatch">
      <AutoMatch autos={automatchAutos} mode="home" embedded />
    </section>

    <Pruebas notes={homeNotes} />

    <section
      class="home-mobility"
      aria-label="Movilidad eléctrica e híbrida"
    >
      <div class="home-mobility__panel">
        <Electricos notes={homeNotes} compact />
        <Hibridos notes={homeNotes} compact />
      </div>
    </section>

    <link rel="stylesheet" href="/css/mobility-split.css?v=13" />

    <Deportes notes={homeNotes} />

    <Noticias notes={homeNotes} />

    <AutoMatchPromo
      variant="compact"
      title="¿Listo para encontrar tu próximo auto?"
      description="Cuando ya exploraste los modelos, usa AutoMatch para comparar y contactar un asesor. Herramienta en evolución: el catálogo sigue creciendo."
      showSecondary={true}
    />
    <!-- Banner marca — oculto temporalmente
    <AdBanner variant="autotech" />
    -->
  </div>

  <link rel="stylesheet" href="/css/home-typography.css?v=115" />
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .automatch-destacado {
    width: min(92%, 1680px);
    max-width: 1680px;
    margin-inline: auto;
    margin-bottom: 0;
    animation: fadeInUp 0.7s ease-out;
  }

  .extra-sections {
    opacity: 1;
    transform: translateY(0);
    max-height: none;
    overflow: visible;
    background-color: var(--home-section-bg, #f0f3f0);
    background-image: var(--home-relief-image);
    background-size: var(--home-relief-size);
    background-repeat: repeat;
  }

  .extra-sections > * {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  /* Noticias al tope: sin slide-up para evitar salto brusco del título */
  .extra-sections > #noticias {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .extra-sections > *:nth-child(1) {
    animation-delay: 0.15s;
  }

  .extra-sections > *:nth-child(2) {
    animation-delay: 0.3s;
  }

  .extra-sections > *:nth-child(3) {
    animation-delay: 0.45s;
  }

  .extra-sections > *:nth-child(4) {
    animation-delay: 0.6s;
  }

  .extra-sections > *:nth-child(5) {
    animation-delay: 0.75s;
  }

  .extra-sections > *:nth-child(6) {
    animation-delay: 0.9s;
  }

  .extra-sections > *:nth-child(7) {
    animation-delay: 1.05s;
  }

  .extra-sections > *:nth-child(8) {
    animation-delay: 1.2s;
  }

  .extra-sections > *:nth-child(9) {
    animation-delay: 1.35s;
  }

  .extra-sections > *:nth-child(10) {
    animation-delay: 1.5s;
  }
</style>
